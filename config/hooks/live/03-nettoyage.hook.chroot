#!/bin/sh
set -e

# Protéger le coeur du bureau contre toute suppression en cascade
apt-mark manual xfce4-panel xfce4-session xfce4-settings xfwm4 \
  xfdesktop4 thunar xfce4-appfinder xfce4-terminal lightdm 2>/dev/null || true

# Retirer les applis et plugins optionnels, seulement s'ils sont installés
for p in parole xfburn orage xfce4-dict xfce4-mailwatch-plugin \
         xfce4-eyes-plugin xfce4-weather-plugin xfce4-sensors-plugin \
         xfce4-cpugraph-plugin xfce4-netload-plugin xfce4-wavelan-plugin \
         xfce4-fsguard-plugin xfce4-diskperf-plugin xfce4-genmon-plugin \
         xfce4-mpc-plugin xfce4-smartbookmark-plugin xfce4-verve-plugin \
         xfce4-timer-plugin gigolo pidgin hexchat transmission-gtk \
         libreoffice-common; do
    if dpkg -s "$p" >/dev/null 2>&1; then
        apt-get purge -y "$p"
    fi
done

# Nettoyage des caches et de la documentation inutile
apt-get clean
rm -rf /var/lib/apt/lists/*
rm -rf /usr/share/man/* /usr/share/info/*
