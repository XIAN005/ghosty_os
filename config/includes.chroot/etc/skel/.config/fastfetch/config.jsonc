{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/usr/share/ghosty_os/Ghostyascii.txt",
    "color": { "1": "white" },
    "padding": { "right": 3 }
  },
  "display": { "separator": ": " },
  "modules": [
    "title",
    "separator",
    { "type": "custom", "format": "OS: GhostyOS" },
    "kernel",
    "uptime",
    "packages",
    "shell",
    "display",
    "de",
    "wm",
    "terminal",
    "cpu",
    "gpu",
    "memory",
    "break",
    { "type": "custom", "format": "Communauté: GhostyOS" },
    "colors"
  ]
}
